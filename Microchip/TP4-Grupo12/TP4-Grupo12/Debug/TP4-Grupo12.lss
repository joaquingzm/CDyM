void timer1_init()
{
	// -- Configuro Compare Output mode, Fast PWM --
	
	//     |    Salida invertida OC1A   |  Salida invertida OC1B    | Bit para FastPWM 8bit |
	TCCR1A |= (1<<COM1A1) | (1<<COM1A0) | (1<<COM1B1) | (1<<COM1B0) | (1<<WGM10);
